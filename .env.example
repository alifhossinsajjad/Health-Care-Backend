# ==============================================================================
# Environment Variables Example for Healthcare Application Backend
# Duplicate this file to '.env' and fill in your actual credentials.
# NEVER commit your actual '.env' file to version control.
# ==============================================================================

# Application Runtime
NODE_ENV=development
PORT=5000

# PostgreSQL Database Connection (Neon, AWS RDS, or Local Docker PostgreSQL)
DATABASE_URL=postgresql://username:password@ep-sample-host.us-east-2.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require

# Better-Auth Configuration
BETTER_AUTH_SECRET=your_better_auth_secret_key_minimum_32_chars
BETTER_AUTH_URL=http://localhost:5000
BETTER_AUTH_SESSION_TOKEN_EXPIRES_IN=1d
BETTER_AUTH_SESSION_TOKEN_UPDATE_AGE=1d

# JWT Secrets for Role-Based Access Control (RBAC)
JWT_ACCESS_SECRET=your_jwt_access_secret_key_minimum_64_characters_recommended
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_64_characters_recommended
JWT_REFRESH_EXPIRES_IN=7d

# SMTP Email Configuration (Nodemailer)
EMAIL_SENDER_SMTP_HOST=smtp.gmail.com
EMAIL_SENDER_SMTP_PORT=465
EMAIL_SENDER_SMTP_USER=support@example.com
EMAIL_SENDER_SMTP_PASS=your_app_specific_password

# Google OAuth2 Authentication
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/callback/google

# Client-Side Application Origin
FRONTEND_URL=http://localhost:3000

# Cloudinary Cloud Storage (For Doctor avatars & generated Prescription PDFs)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Stripe Payment Gateway
STRIPE_SECRET_KEY=[your_stripe_secrect_key]
STRIPE_WEBHOOK_SECRET=[your_stripe_webhook_secrect]

# Initial Super Admin Seeder Credentials
SUPER_ADMIN_EMAIL=[EMAIL_ADDRESS]
SUPER_ADMIN_PASSWORD=[PASSWORD]

# Redis & BullMQ Queue Configuration (Supports Upstash Cloud TLS or Local Docker)
# For Upstash Cloud (TLS required):
REDIS_URL=rediss://default:your_upstash_token@your-redis-endpoint.upstash.io:6379

# Or For Local Docker Redis (uncomment if running local Redis):
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_PASSWORD=
