model VideoConsultationLog {
    id            String      @id @default(uuid(7))
    appointmentId String
    appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

    callerId      String
    caller        User        @relation("CallerConsultations", fields: [callerId], references: [id], onDelete: Cascade)

    receiverId    String
    receiver      User        @relation("ReceiverConsultations", fields: [receiverId], references: [id], onDelete: Cascade)

    status        CallStatus  @default(INITIATED)
    startedAt     DateTime    @default(now())
    endedAt       DateTime?
    durationSec   Int?        @default(0)

    createdAt     DateTime    @default(now())
    updatedAt     DateTime    @updatedAt

    @@index([appointmentId])
    @@index([callerId])
    @@index([receiverId])
    @@map("video_consultation_logs")
}
