<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Consultation Reminder</title>
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      background-color: #f1f5f9;
      margin: 0;
      padding: 24px;
      color: #1e293b;
    }
    .container {
      max-width: 600px;
      margin: 0 auto;
      background-color: #ffffff;
      padding: 40px;
      border-radius: 16px;
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.02);
      border: 1px solid #e2e8f0;
    }
    .header {
      text-align: center;
      margin-bottom: 28px;
    }
    .badge {
      display: inline-block;
      padding: 6px 16px;
      background-color: #eff6ff;
      color: #2563eb;
      border-radius: 9999px;
      font-weight: 700;
      font-size: 13px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      border: 1px solid #bfdbfe;
    }
    .badge.urgent {
      background-color: #fef2f2;
      color: #dc2626;
      border-color: #fecaca;
    }
    .title {
      font-size: 26px;
      font-weight: 800;
      color: #0f172a;
      margin: 16px 0 8px;
      letter-spacing: -0.02em;
    }
    .subtitle {
      font-size: 15px;
      color: #64748b;
      margin: 0;
    }
    .content p {
      font-size: 15px;
      line-height: 1.6;
      color: #475569;
      margin: 16px 0;
    }
    .alert-card {
      background: linear-gradient(135deg, #f8fafc 0%, #eff6ff 100%);
      border: 1px solid #dbeafe;
      border-left: 5px solid #2563eb;
      border-radius: 10px;
      padding: 20px;
      margin: 24px 0;
    }
    .alert-row {
      display: flex;
      justify-content: space-between;
      margin-bottom: 8px;
      font-size: 14px;
    }
    .alert-label {
      color: #64748b;
      font-weight: 500;
    }
    .alert-value {
      color: #0f172a;
      font-weight: 700;
    }
    .btn-container {
      text-align: center;
      margin: 32px 0 24px;
    }
    .btn {
      display: inline-block;
      padding: 14px 32px;
      background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
      color: #ffffff !important;
      text-decoration: none;
      font-weight: 600;
      font-size: 16px;
      border-radius: 10px;
      box-shadow: 0 4px 14px rgba(37, 99, 235, 0.35);
      transition: all 0.2s ease;
    }
    .checklist {
      background-color: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 10px;
      padding: 16px 20px;
      margin-top: 24px;
    }
    .checklist-title {
      font-size: 13px;
      font-weight: 700;
      text-transform: uppercase;
      color: #475569;
      letter-spacing: 0.05em;
      margin-bottom: 10px;
    }
    .checklist ul {
      margin: 0;
      padding-left: 20px;
      color: #64748b;
      font-size: 13px;
      line-height: 1.6;
    }
    .footer {
      margin-top: 36px;
      padding-top: 20px;
      border-top: 1px solid #e2e8f0;
      font-size: 12px;
      color: #94a3b8;
      text-align: center;
      line-height: 1.5;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <span class="badge urgent">🚨 Starts in <%= minutesLeft %> Minutes</span>
      <h1 class="title">Your Consultation is Ready</h1>
      <p class="subtitle">Healthcare Telemedicine Video Consultation</p>
    </div>

    <div class="content">
      <p>Hello <strong><%= name %></strong>,</p>
      <p>This is an automated reminder that your scheduled video consultation is starting in <strong><%= minutesLeft %> minutes</strong>.</p>

      <div class="alert-card">
        <div class="alert-row">
          <span class="alert-label">Participant:</span>
          <span class="alert-value"><%= peerName %> (<%= peerRole %>)</span>
        </div>
        <div class="alert-row">
          <span class="alert-label">Time Remaining:</span>
          <span class="alert-value" style="color: #dc2626;"><%= minutesLeft %> Minutes</span>
        </div>
        <div class="alert-row" style="margin-bottom: 0;">
          <span class="alert-label">Status:</span>
          <span class="alert-value" style="color: #16a34a;">Room Open &amp; Ready</span>
        </div>
      </div>

      <div class="btn-container">
        <a href="<%= consultationUrl %>" class="btn" target="_blank">Enter Consultation Room</a>
      </div>

      <div class="checklist">
        <div class="checklist-title">Quick Pre-Call Checklist:</div>
        <ul>
          <li>Grant browser permissions for your camera and microphone.</li>
          <li>Ensure a stable internet connection and quiet surroundings.</li>
          <li>Have your recent lab reports or medical history ready if applicable.</li>
        </ul>
      </div>

      <p style="font-size: 13px; color: #64748b; margin-top: 24px; text-align: center;">
        If the button above does not work, copy and paste this URL into your browser:<br>
        <a href="<%= consultationUrl %>" style="color: #2563eb; word-break: break-all;"><%= consultationUrl %></a>
      </p>
    </div>

    <div class="footer">
      <p>&copy; <%= new Date().getFullYear() %> Health Care Telemedicine System. All rights reserved.</p>
      <p>HIPAA &amp; SOC2 Compliant Encrypted Telehealth Communications</p>
    </div>
  </div>
</body>
</html>
